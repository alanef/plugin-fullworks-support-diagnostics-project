{
  "name": "fullworks/fullworks-support-diagnostics-project",
  "description": "Development project for the PluginPulse Connect WordPress plugin",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "alan",
      "email": "alan@fullworksplugins.com"
    }
  ],
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "wp-coding-standards/wpcs": ">=2.3.0",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^1.1",
    "phpstan/phpstan": "^1.10",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "scripts": {
    "post-update-cmd": [
      "@plugin-update",
      "@make-pot"
    ],
    "plugin-update": "if [ -f fullworks-support-diagnostics/composer.json ]; then composer update -d fullworks-support-diagnostics; fi",
    "make-pot": "mkdir -p fullworks-support-diagnostics/languages && wp i18n make-pot ./fullworks-support-diagnostics ./fullworks-support-diagnostics/languages/fullworks-support-diagnostics.pot --skip-audit --exclude='vendor,includes/vendor,node_modules'",
    "build": [
      "if [ -f fullworks-support-diagnostics/composer.json ]; then composer install -d fullworks-support-diagnostics --no-dev; fi",
      "mkdir -p zipped",
      "wp dist-archive fullworks-support-diagnostics zipped/fullworks-support-diagnostics-free.zip --force",
      "zip -qd zipped/fullworks-support-diagnostics-free.zip fullworks-support-diagnostics/.distignore >/dev/null 2>&1 || true"
    ],
    "phpcs": "phpcs fullworks-support-diagnostics -s --standard=phpcs_sec.xml --ignore=*/vendor/* --extensions=php",
    "compat:8.4": "phpcs fullworks-support-diagnostics -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.4",
    "compat:8.3": "phpcs fullworks-support-diagnostics -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.3",
    "compat:8.2": "phpcs fullworks-support-diagnostics -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.2",
    "compat:8.1": "phpcs fullworks-support-diagnostics -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.1",
    "compat:8.0": "phpcs fullworks-support-diagnostics -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.0",
    "compat:7.4": "phpcs fullworks-support-diagnostics -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 7.4",
    "check": [
      "@compat:8.4",
      "@compat:8.3",
      "@compat:8.2",
      "@compat:8.1",
      "@compat:8.0",
      "@compat:7.4",
      "@phpcs"
    ],
    "test": "npm test",
    "phpcbf": "phpcbf -p",
    "phpstan": "phpstan analyse"
  }
}
